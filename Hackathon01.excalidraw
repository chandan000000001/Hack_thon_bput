      "type": "text",
      "x": 19799.862255555487,
      "y": 48784.26449571303,
      "width": 461.41217041015625,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",

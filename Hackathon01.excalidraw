    {
      "id": "p4E_Ie6b3EdFA8VoDpqIv",
      "type": "text",
      "x": 24751.306534226736,
      "y": 44951.84323494479,
      "width": 742.0322875976562,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5Z",
      "roundness": null,
      "seed": 1395374402,
      "version": 312,
      "versionNonce": 1805656862,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788710687612,
      "link": null,
      "locked": false,
      "text": "We can use OpenRouter as the LLM gateway:\n-Phishing email explanation\n-Social engineering detection\n-Impersonation detection\n-Threat summary generation\n-Risk justification\n-Response recommendation\n-MITRE ATT&CK mapping\n-SOC assistant chat",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "We can use OpenRouter as the LLM gateway:\n-Phishing email explanation\n-Social engineering detection\n-Impersonation detection\n-Threat summary generation\n-Risk justification\n-Response recommendation\n-MITRE ATT&CK mapping\n-SOC assistant chat",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NIfj8CQex0czbk2auk8rU",
      "type": "text",
      "x": 24689.275195482154,
      "y": 45373.09354049574,
      "width": 881.3162841796875,
      "height": 810,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5a",
      "roundness": null,
      "seed": 849395906,
      "version": 263,
      "versionNonce": 808062814,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788710687612,
      "link": null,
      "locked": false,
      "text": " JSON schema enforcement\n{\n  \"threat_detected\": true,\n  \"threat_type\": \"phishing\",\n  \"risk_score\": 87,\n  \"severity\": \"High\",\n  \"confidence\": 0.92,\n  \"indicators\": [\n    \"Sender domain resembles legitimate organization\",\n    \"Urgent credential verification requested\",\n    \"Suspicious URL detected\"\n  ],\n  \"recommended_actions\": [\n    \"Quarantine email\",\n    \"Block sender domain\",\n    \"Warn end user\"\n  ]\n}",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": " JSON schema enforcement\n{\n  \"threat_detected\": true,\n  \"threat_type\": \"phishing\",\n  \"risk_score\": 87,\n  \"severity\": \"High\",\n  \"confidence\": 0.92,\n  \"indicators\": [\n    \"Sender domain resembles legitimate organization\",\n    \"Urgent credential verification requested\",\n    \"Suspicious URL detected\"\n  ],\n  \"recommended_actions\": [\n    \"Quarantine email\",\n    \"Block sender domain\",\n    \"Warn end user\"\n  ]\n}",

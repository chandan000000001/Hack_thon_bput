    {
      "id": "vpchH6mVkQ7trfeQC5s2p",
      "type": "text",
      "x": 20363.23129676602,
      "y": 46441.412582458994,
      "width": 3042.03662109375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5f",
      "roundness": null,
      "seed": 1683404318,
      "version": 98,
      "versionNonce": 1716140894,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788711081807,
      "link": null,
      "locked": false,
      "text": "This module will analyze:\nEmails ,SMS messages , Social media messages , QR-code phishing references ,Fraudulent websites ,Malicious URLs\nDetection Features:\n Urgency language ,Threat language ,Credential request ,Sender impersonation,Suspicious domainLook-alike domain URL shorteners Redirect chainUnknown TLDs Suspicious attachments\nMismatch between display text and actual URL ,Unusual sender behavior ,Brand impersonation\nTechniques: Rule-based indicators , NLP classification ,LLM reasoning , URL feature extraction Domain reputation checks\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This module will analyze:\nEmails ,SMS messages , Social media messages , QR-code phishing references ,Fraudulent websites ,Malicious URLs\nDetection Features:\n Urgency language ,Threat language ,Credential request ,Sender impersonation,Suspicious domainLook-alike domain URL shorteners Redirect chainUnknown TLDs Suspicious attachments\nMismatch between display text and actual URL ,Unusual sender behavior ,Brand impersonation\nTechniques: Rule-based indicators , NLP classification ,LLM reasoning , URL feature extraction Domain reputation checks\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "raUcmelFrIEX-yJMS9Kh9",
      "type": "text",

      "boundElements": [],
      "updated": 1788708410809,
      "link": null,
      "locked": false,
      "text": "APIs or interfaces to accept inputs\n (emails, URLs, images, \naudio, authentication logs).",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "APIs or interfaces to accept inputs\n (emails, URLs, images, \naudio, authentication logs).",

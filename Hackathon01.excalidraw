      "roundness": null,
      "seed": 122777346,
      "version": 553,
      "versionNonce": 1352007646,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788708430016,
      "link": null,
      "locked": false,
      "text": "Response & Dashboard Layer:\nA centralized Cybersecurity\nCommand Dashboard (e.g., built\nwith React, Streamlit, or\nGrafana) displaying metrics,\nattack timelines, and actionable\nmitigation buttons (e.g.,\n\"Quarantine Email\", \"Revoke\nSession\").\n",
      "fontSize": 28.804128962208054,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Response & Dashboard Layer: A centralized Cybersecurity Command Dashboard (e.g., built with React, Streamlit, or Grafana) displaying metrics, attack timelines, and actionable mitigation buttons (e.g., \"Quarantine Email\", \"Revoke Session\").\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

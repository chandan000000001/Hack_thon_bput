      "seed": 1800876766,
      "version": 148,
      "versionNonce": 687473026,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788714956621,
      "link": null,
      "locked": false,
      "text": "Recomended defau;alt Scale\n0 - 20    Safe\n21 - 40   Low\n41 - 60   Medium\n61 - 80   High\n81 - 100  Critical",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Recomended defau;alt Scale\n0 - 20    Safe\n21 - 40   Low\n41 - 60   Medium\n61 - 80   High\n81 - 100  Critical",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "wdb8toUY5crYVQIygvqXr",
      "type": "text",
      "x": 19730.08658433845,
      "y": 49126.497549777545,
      "width": 2196.792236328125,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6i",
      "roundness": null,
      "seed": 697846146,
      "version": 116,
      "versionNonce": 1661108546,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788714956621,
      "link": null,
      "locked": false,
      "text": "The risk score should be calculated using multiple factors\nFinal Risk Score =    Detector Confidence  + Threat Severity  + Asset Criticality  + Historical Context  + User Impact  + Evidence Strength\nPhishing email detected:\n- High urgency language\n- Credential harvesting URL\n- Spoofed domain\n- Targeting finance user\nRisk Score: 88\nSeverity: Critical",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The risk score should be calculated using multiple factors\nFinal Risk Score =    Detector Confidence  + Threat Severity  + Asset Criticality  + Historical Context  + User Impact  + Evidence Strength\nPhishing email detected:\n- High urgency language\n- Credential harvesting URL\n- Spoofed domain\n- Targeting finance user\nRisk Score: 88\nSeverity: Critical",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {

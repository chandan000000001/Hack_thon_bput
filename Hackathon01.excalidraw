    },
    {
      "id": "SPe5kWP2QWyCxOWdC9L-M",
      "type": "text",
      "x": 19312.89692452595,
      "y": 44016.81770633597,
      "width": 419.8353658274243,
      "height": 180.02580601380032,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

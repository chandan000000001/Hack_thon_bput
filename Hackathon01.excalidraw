    {
      "id": "MM4J_6BJz4tl27uhih6M0",
      "type": "text",
      "x": 22756.721588605786,
      "y": 45539.772534573865,
      "width": 1737.6483154296875,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5X",
      "roundness": null,
      "seed": 1394697154,
      "version": 156,
      "versionNonce": 939752862,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788710489842,
      "link": null,
      "locked": false,
      "text": "\nCore ML Libraries -> Python , scikit-learn , XGBoost , PyTorch ,Hugging Face Transformers , ONNX Runtime\n\nNLP = Hugging Face Transformers , sentence-transformers , spaCy , OpenRouter LLM , \n\nComputer Vision = OpenCV , PyTorch , torchvision , Hugging Face vision models ,\n\nAudio = torchaudio , librosa , Hugging Face audio models\n\nExplainability = SHAP , LIME , LLM-based explanation generator",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\nCore ML Libraries -> Python , scikit-learn , XGBoost , PyTorch ,Hugging Face Transformers , ONNX Runtime\n\nNLP = Hugging Face Transformers , sentence-transformers , spaCy , OpenRouter LLM , \n\nComputer Vision = OpenCV , PyTorch , torchvision , Hugging Face vision models ,\n\nAudio = torchaudio , librosa , Hugging Face audio models\n\nExplainability = SHAP , LIME , LLM-based explanation generator",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "-Ve8bzQF7L4GGNMlCWHwP",

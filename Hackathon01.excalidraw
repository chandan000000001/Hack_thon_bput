      "boundElements": [],
      "updated": 1788715156681,
      "link": null,
      "locked": false,
      "text": "Authentication\nPOST /api/v1/auth/login\nPOST /api/v1/auth/refresh\nGET  /api/v1/auth/me\n\n\n\n\n\n\n\nIncidents\nGET /api/v1/events\nGET /api/v1/events/{event_id}\nGET /api/v1/alerts\nGET /api/v1/alerts/{alert_id}\n\n\n\n\n\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Authentication\nPOST /api/v1/auth/login\nPOST /api/v1/auth/refresh\nGET  /api/v1/auth/me\n\n\n\n\n\n\n\nIncidents\nGET /api/v1/events\nGET /api/v1/events/{event_id}\nGET /api/v1/alerts\nGET /api/v1/alerts/{alert_id}\n\n\n\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

    {
      "id": "3gD6vGu5mumNzoHTCaA5S",
      "type": "text",
      "x": 19607.089630117473,
      "y": 45089.73835969294,
      "width": 1587.744384765625,
      "height": 855,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5D",
      "roundness": null,
      "seed": 53935902,
      "version": 100,
      "versionNonce": 194980610,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788709912225,
      "link": null,
      "locked": false,
      "text": "Backend Framework\n->FastAPI\nReason:\n->Modern,Fast,Asynchronous,Easy API documentation with Swagger, Good for AI workloads\n    Good for production APIs\nAuthentication:\n->JWT authentication , ->Role-based access control\nRoles can include: Admin , SOC Analyst , Auditor ,Viewer\nTask Queue\nSome AI detection tasks may take time, especially deepfake video analysis or large email analysis.\nTherefore, we should use: Celery , Redis\nThis allows background processing.\nExample:\nUser uploads video\n→ Backend stores file\n→ Task sent to Celery worker\n→ Worker runs deepfake model\n→ Result saved to database\n→ Dashboard updates",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Backend Framework\n->FastAPI\nReason:\n->Modern,Fast,Asynchronous,Easy API documentation with Swagger, Good for AI workloads\n    Good for production APIs\nAuthentication:\n->JWT authentication , ->Role-based access control\nRoles can include: Admin , SOC Analyst , Auditor ,Viewer\nTask Queue\nSome AI detection tasks may take time, especially deepfake video analysis or large email analysis.\nTherefore, we should use: Celery , Redis\nThis allows background processing.\nExample:\nUser uploads video\n→ Backend stores file\n→ Task sent to Celery worker\n→ Worker runs deepfake model\n→ Result saved to database\n→ Dashboard updates",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "i03cV2PdXkXiqYUVxC5KV",
      "type": "text",
      "x": 21277.06737238643,
      "y": 44879.270075859036,
      "width": 740.5562133789062,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5P",
      "roundness": null,
      "seed": 1703265246,
      "version": 169,
      "versionNonce": 2103642242,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788709922464,
      "link": null,
      "locked": false,
      "text": "PostgreSQL\nReason:\n-Structured data\n-Strong relational support\n-Good for events, alerts, users, logs, incidents\n-Can be extended with pgvector if needed\nWe can use:\nSQLAlchemy as ORM\nAlembic for migrations",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "PostgreSQL\nReason:\n-Structured data\n-Strong relational support\n-Good for events, alerts, users, logs, incidents\n-Can be extended with pgvector if needed\nWe can use:\nSQLAlchemy as ORM\nAlembic for migrations",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

      "isDeleted": false,
      "boundElements": [],
      "updated": 1788710210377,
      "link": null,
      "locked": false,
      "text": "  \nWe need to store:\n-Uploaded emails-URLs-Images-Audio files-Videos-Logs-Evidence screenshots-Model outputs\n=>For local development:-MinIO\nFor cloud deployment:AWS S3 , GCP Cloud Storage , Azure Blob Storage\n=>For prototype:  Use MinIO.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "  \nWe need to store:\n-Uploaded emails-URLs-Images-Audio files-Videos-Logs-Evidence screenshots-Model outputs\n=>For local development:-MinIO\nFor cloud deployment:AWS S3 , GCP Cloud Storage , Azure Blob Storage\n=>For prototype:  Use MinIO.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

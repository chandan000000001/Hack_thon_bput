    },
    {
      "id": "LpmTbpwU-D4S4qjTW_gYw",
      "type": "text",
      "x": 21442.322285930728,
      "y": 45474.948736739025,
      "width": 1140.6602783203125,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5S",
      "roundness": null,
      "seed": 53520258,
      "version": 58,
      "versionNonce": 1358297054,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788709989109,
      "link": null,
      "locked": false,
      "text": "For AI-powered analysis, similarity search, phishing pattern matching, \nand impersonation detection, \nwe can use: pgvector\nThis is easier because we can keep everything inside PostgreSQL.\nAlternative: Qdrant & Weaviate\nBut for simplicity, I recommend:\nPostgreSQL + pgvector",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For AI-powered analysis, similarity search, phishing pattern matching, \nand impersonation detection, \nwe can use: pgvector\nThis is easier because we can keep everything inside PostgreSQL.\nAlternative: Qdrant & Weaviate\nBut for simplicity, I recommend:\nPostgreSQL + pgvector",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

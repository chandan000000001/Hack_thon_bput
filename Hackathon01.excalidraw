      "versionNonce": 548458306,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788708415008,
      "link": null,
      "locked": false,
      "text": "NLP/LLM Module: For analyzing\nemail/messagetext,\n sender intent, and urgency \n(e.g., fine-tuned BERT or open-\nsource LLMs).",
      "fontSize": 28.804128962208054,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NLP/LLM Module: For analyzing email/messagetext,\n sender intent, and urgency \n(e.g., fine-tuned BERT or open-source LLMs).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "LnmrP-1girWqgxyg3Lwez",
      "type": "text",
      "x": 19312.7122622725,
      "y": 44211.37428246618,
      "width": 419.8353658274243,
      "height": 180.02580601380032,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],

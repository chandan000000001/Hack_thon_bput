      "isDeleted": false,
      "boundElements": [],
      "updated": 1788708437138,
      "link": null,
      "locked": false,
      "text": "Computer Vision/Audio Module:\nFor deepfake detection (e.g.,\nCNNs, Vision Transformers, or\nspecialized deepfake detection\nmodels like Xception).",
      "fontSize": 28.804128962208054,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Computer Vision/Audio Module: For deepfake detection (e.g., CNNs, Vision Transformers, or specialized deepfake detection models like Xception).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ePrFUWGtlPk1LPyDDjNvA",
      "type": "text",
      "x": 20279.77656991342,
      "y": 44021.85719880116,
      "width": 419.8353658274243,
      "height": 360.05161202760064,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,

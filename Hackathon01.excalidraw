      "text": "{\n  \"module\": \"phishing_detection\",\n  \"threat_type\": \"phishing_email\",\n  \"risk_level\": \"High\",\n  \"risk_score\": 84,\n  \"confidence\": 0.91,\n  \"indicators\": [\n    \"Message creates urgency\",\n    \"Requests credential verification\",\n    \"Sender domain closely resembles\nlegitimate domain\"\n  ]\n}",

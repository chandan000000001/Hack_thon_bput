      "boundElements": [],
      "updated": 1788710778079,
      "link": null,
      "locked": false,
      "text": "React Dashboard\n       |\n       | HTTPS REST / WebSocket\n       v\nFastAPI Backend\n       |\n       |----------------------------------> PostgreSQL\n       |\n       |----------------------------------> Redis\n       |\n       |----------------------------------> MinIO / S3\n       |\n       |----------------------------------> Celery Workers\n       |                                        |\n       |                                        |--> Phishing Detection Engine\n       |                                        |--> URL Analysis Engine\n       |                                        |--> Deepfake Detection Engine\n       |                                        |--> Impersonation Detection Engine\n       |                                        |--> Account Takeover Detection Engine\n       |                                        |--> Network Anomaly Detection Engine\n       |                                        |--> API Abuse Detection Engine\n       |                                        |--> OpenRouter LLM Engine\n       |\n       |----------------------------------> Risk Scoring Engine\n       |\n       |----------------------------------> Explainable AI Engine\n       |\n       |----------------------------------> Response Recommendation Engine",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "React Dashboard\n       |\n       | HTTPS REST / WebSocket\n       v\nFastAPI Backend\n       |\n       |----------------------------------> PostgreSQL\n       |\n       |----------------------------------> Redis\n       |\n       |----------------------------------> MinIO / S3\n       |\n       |----------------------------------> Celery Workers\n       |                                        |\n       |                                        |--> Phishing Detection Engine\n       |                                        |--> URL Analysis Engine\n       |                                        |--> Deepfake Detection Engine\n       |                                        |--> Impersonation Detection Engine\n       |                                        |--> Account Takeover Detection Engine\n       |                                        |--> Network Anomaly Detection Engine\n       |                                        |--> API Abuse Detection Engine\n       |                                        |--> OpenRouter LLM Engine\n       |\n       |----------------------------------> Risk Scoring Engine\n       |\n       |----------------------------------> Explainable AI Engine\n       |\n       |----------------------------------> Response Recommendation Engine",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },

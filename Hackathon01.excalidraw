    {
      "id": "yjsSuVthPRbWkgbN7T2iG",
      "type": "text",
      "x": 22151.98433038896,
      "y": 48713.75170501239,
      "width": 658.7282104492188,
      "height": 405,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6k",
      "roundness": null,
      "seed": 878620226,
      "version": 30,
      "versionNonce": 1888858782,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788714963295,
      "link": null,
      "locked": false,
      "text": "This comes from the detection models.\nExample:\nIndicators:\n- Sender domain: micr0soft-support.com\n- Legitimate brand: Microsoft\n- URL contains credential keyword\n- Redirect chain detected\n- Message contains urgency phrase\n- Attachment has executable extension",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This comes from the detection models.\nExample:\nIndicators:\n- Sender domain: micr0soft-support.com\n- Legitimate brand: Microsoft\n- URL contains credential keyword\n- Redirect chain detected\n- Message contains urgency phrase\n- Attachment has executable extension",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "2W0gdT1AQPkjmGW79An3z",
      "type": "text",
      "x": 22137.73787526316,
      "y": 49146.84394083682,
      "width": 1304.784423828125,
      "height": 540,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6l",
      "roundness": null,
      "seed": 2100927298,
      "version": 30,
      "versionNonce": 784445150,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788714963295,
      "link": null,
      "locked": false,
      "text": "LLM Explanation Layer\nOpenRouter can convert technical indicators into a human-readable explanation.\n{\n  \"task\": \"explain_cyber_threat\",\n  \"threat_type\": \"phishing\",\n  \"indicators\": [\n    \"Sender domain closely resembles legitimate domain\",\n    \"Urgent credential verification requested\",\n    \"Embedded URL redirects to unrelated domain\",\n    \"Message targets finance department\"\n  ]\n}",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "LLM Explanation Layer\nOpenRouter can convert technical indicators into a human-readable explanation.\n{\n  \"task\": \"explain_cyber_threat\",\n  \"threat_type\": \"phishing\",\n  \"indicators\": [\n    \"Sender domain closely resembles legitimate domain\",\n    \"Urgent credential verification requested\",\n    \"Embedded URL redirects to unrelated domain\",\n    \"Message targets finance department\"\n  ]\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "apz-OwAg_b9U4-glxXLzp",
      "type": "text",
      "x": 22131.816692351502,
      "y": 49719.59595706629,
      "width": 2197.87255859375,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6n",
      "roundness": null,
      "seed": 591032002,
      "version": 32,
      "versionNonce": 1990468382,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788714963295,
      "link": null,
      "locked": false,
      "text": "Example LLM output: This event is classified as High Risk because the sender domain closely imitates a legitimate organization.\n The message requests urgent credential verification, which is a common social engineering technique. Additionally, the embedded URL\n redirects to an unrelated domain, increasing the likelihood of credential harvesting. ",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Example LLM output: This event is classified as High Risk because the sender domain closely imitates a legitimate organization.\n The message requests urgent credential verification, which is a common social engineering technique. Additionally, the embedded URL\n redirects to an unrelated domain, increasing the likelihood of credential harvesting. ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },

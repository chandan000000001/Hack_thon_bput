      "text": "3.4 Vector Database / Embedding Store\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3.4 Vector Database / Embedding Store\n",

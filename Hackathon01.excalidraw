      "text": "{\n  \"recommended_actions\": [\n    \"Quarantine email\",\n    \"Block sender domain\",\n    \"Disable embedded URL\",\n    \"Notify SOC analyst\",\n    \"Require password reset for targeted user\"\n  ],\n  \"automation_level\": \"semi-automatic\",\n  \"priority\": \"High\"\n}",
